<?xml version='1.0' encoding='utf-8'?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DogruTemin.Wpf" xmlns:models="clr-namespace:DogruTemin.Wpf.Models" xmlns:shell="clr-namespace:DogruTemin.Wpf.Features.Shell" x:Class="DogruTemin.Wpf.Features.Institution.SettingsPage">
  <ScrollViewer x:Name="SettingsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,8,18">
      <TextBlock Text="AYARLAR" Style="{StaticResource PageTitle}"/>
      <TextBlock Text="Çalışma alanınızı ekranınıza göre düzenleyin." Style="{StaticResource PageSubtitle}"/>
      <Border Style="{StaticResource PremiumPanel}" Padding="24">
        <StackPanel>
          <DockPanel>
            <Border DockPanel.Dock="Left" Style="{StaticResource InsetCardPlate}" Width="30" Height="30" Margin="0,0,8,0">
              <Image Source="{StaticResource InsetLedgerIcon}" Width="18" Height="18"/>
            </Border>
            <TextBlock Text="EKRAN VE PENCERE" FontFamily="Segoe UI" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource MetricGold}"/>
          </DockPanel>
          <TextBlock Text="Pencere boyutu" Style="{StaticResource PremiumFieldLabel}" Margin="0,22,0,8"/>
          <ComboBox x:Name="WindowSizeChoice" Style="{StaticResource PremiumFieldComboBox}" Width="320" Height="35" HorizontalAlignment="Left" SelectedIndex="3">
            <ComboBoxItem Tag="Auto" Content="Otomatik · ekrana sığdır"/>
            <ComboBoxItem Tag="1280x720" Content="1280 × 720"/>
            <ComboBoxItem Tag="1366x768" Content="1366 × 768"/>
            <ComboBoxItem Tag="1920x1080" Content="1920 × 1080"/>
            <ComboBoxItem Tag="Maximized" Content="Ekranı kapla"/>
          </ComboBox>
          <TextBlock Text="Seçiminiz bir sonraki açılış için de saklanır. Büyük boyutlar ekranın kullanılabilir alanına sığdırılır. Pencere kenarından boyutu ayrıca değiştirebilirsiniz." Foreground="#C3D3E3" TextWrapping="Wrap" MaxWidth="700" HorizontalAlignment="Left" Margin="0,14,0,18" FontSize="14"/>
          <Button Content="UYGULA VE KAYDET" Style="{StaticResource WorkspaceAction}" Width="220" HorizontalAlignment="Left" Click="ApplyWindowSettings_Click"/>
          <CheckBox x:Name="AutoBackupCheckBox" Foreground="{StaticResource PremiumMutedTextBrush}" Content="Kayıtta aktif işlem ve arşiv kaydının tarih damgalı yedeğini oluştur" IsChecked="True" Margin="0,16,0,0" FontSize="11.5" Checked="AutoBackup_Changed" Unchecked="AutoBackup_Changed"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource InsetCardShell}" Padding="20" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="Her ekranda okunabilir çalışma alanı" Foreground="{StaticResource MetricGold}" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="Yazı boyutları korunur. Dar pencerelerde uzun formlar ve tablolar kaydırılarak kullanılabilir. Veri giriş ekranları sol menüde her zaman açıktır." Foreground="{StaticResource PremiumMutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="14"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
