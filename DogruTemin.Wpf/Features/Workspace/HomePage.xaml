<?xml version='1.0' encoding='utf-8'?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DogruTemin.Wpf" xmlns:models="clr-namespace:DogruTemin.Wpf.Models" xmlns:shell="clr-namespace:DogruTemin.Wpf.Features.Shell" x:Class="DogruTemin.Wpf.Features.Workspace.HomePage">
  <ScrollViewer x:Name="HomeView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,8,16">
      <TextBlock Text="DOĞRUTEMİN İŞLEM PANELİ" Style="{StaticResource PageTitle}"/>
      <TextBlock Text="Aktif işlemin mali, operasyonel ve belge durumunu tek bakışta izleyin." Style="{StaticResource PageSubtitle}"/>
      <!-- Aktif işlem / hazırlık kahraman kartı -->
      <Border CornerRadius="12" Padding="20,15" Margin="0,0,0,12" BorderBrush="{StaticResource PremiumGoldBorderBrush}" BorderThickness="1.25">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#082947" Offset="0"/>
            <GradientStop Color="#0C3A62" Offset="0.62"/>
            <GradientStop Color="#123F67" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="245"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Background="#354C65" CornerRadius="11" Padding="9,4" Margin="0,0,10,0">
                <TextBlock Text="AKTİF İŞLEM" Foreground="#D9E9F6" FontSize="11" FontWeight="Bold"/>
              </Border>
              <TextBlock x:Name="HomeWarningCountText" Text="0 UYARI" Foreground="#FFC75B" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="HomeJobTitleText" Text="Henüz aktif işlem başlığı girilmedi" TextWrapping="Wrap" FontSize="22" FontWeight="SemiBold" Foreground="White" Margin="0,7,24,0"/>
            <TextBlock x:Name="HomeApprovalDateText" Text="Harcama belgesi tarihi: Henüz belirtilmedi" Foreground="#C5D7E7" FontSize="12.5" Margin="0,5,0,0"/>
            <Grid Width="690" HorizontalAlignment="Left" Margin="0,12,0,0">
              <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="8"/>
                <RowDefinition/>
              </Grid.RowDefinitions>
              <Grid>
                <TextBlock Text="GENEL HAZIRLIK" Foreground="#BFD2E3" FontSize="10.5" FontWeight="SemiBold"/>
                <TextBlock x:Name="HomeReadinessText" Text="%0" Foreground="#FFBF36" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right"/>
              </Grid>
              <Grid Grid.Row="2">
                <Border Height="8" Background="#384C64" CornerRadius="5"/>
                <Border x:Name="HomeReadinessBar" Height="8" Width="0" HorizontalAlignment="Left" Background="#F4C45E" CornerRadius="5"/>
              </Grid>
            </Grid>
            <TextBlock x:Name="HomeReadinessHintText" Text="Süreç bilgileri girildikçe hazırlık durumu otomatik güncellenir." Foreground="#AFC5D8" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"/>
          </StackPanel>
          <Border Grid.Column="1" Background="#111F36" BorderBrush="#335A79" BorderThickness="1" CornerRadius="11" Padding="15,12" VerticalAlignment="Center">
            <StackPanel>
              <TextBlock Text="İŞLEM NO" Foreground="#91ABC0" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Right"/>
              <TextBlock x:Name="HomeOperationNumberText" Text="Henüz yok" Foreground="White" FontSize="21" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
              <Border Height="1" Background="#384C64" Margin="0,11,0,9"/>
              <TextBlock Text="SON KAYIT" Foreground="#91ABC0" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Right"/>
              <TextBlock x:Name="HomeHeroLastSavedText" Text="Henüz kaydedilmedi" Foreground="#DCE9F4" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,3,0,0"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
      <!-- Akıllı iş akışı -->
      <Border Style="{StaticResource PremiumPanel}" Padding="14" Margin="0,0,0,12">
        <StackPanel>
          <Grid Margin="0,0,0,10">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="9" Height="9" Fill="{StaticResource Gold500Brush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="AKILLI İŞ AKIŞI" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Gold500Brush}"/>
              </StackPanel>
              <TextBlock Text="Her kart mevcut durumu ve ilgili aşamaya geçişi tek yerde gösterir." Foreground="{StaticResource PremiumMutedTextBrush}" FontSize="11.5" Margin="17,2,0,0"/>
            </StackPanel>
            <Border Background="#23374E" BorderBrush="#4B6F8D" BorderThickness="1" CornerRadius="12" Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Center">
              <TextBlock x:Name="HomeStageSummaryText" Text="0 / 5 TAMAM" Foreground="{StaticResource Gold500Brush}" FontSize="12" FontWeight="Bold"/>
            </Border>
          </Grid>
          <UniformGrid Columns="5">
            <Border Background="#111F36" BorderBrush="#8FC88B09" BorderThickness="1" CornerRadius="10" Margin="0,0,5,0" Padding="10">
              <StackPanel>
                <StackPanel>
                  <TextBlock Text="01  KURUM / KOMİSYON" FontWeight="Bold" FontSize="11.5" Foreground="White" TextWrapping="Wrap"/>
                  <TextBlock x:Name="HomeStageCommissionStatus" Text="EKSİK" HorizontalAlignment="Left" Margin="0,3,0,0" FontWeight="Bold" FontSize="11" Foreground="#FFBF36"/>
                </StackPanel>
                <TextBlock x:Name="HomeStageCommissionDetail" Text="Kurum ve komisyon bilgilerini tamamlayın." TextWrapping="Wrap" Foreground="#B9CBDA" FontSize="11" Margin="0,6,0,7" MinHeight="34"/>
              </StackPanel>
            </Border>
            <Border Background="#111F36" BorderBrush="#8FC88B09" BorderThickness="1" CornerRadius="10" Margin="5,0" Padding="10">
              <StackPanel>
                <StackPanel>
                  <TextBlock Text="02  MAL / HİZMET" FontWeight="Bold" FontSize="11.5" Foreground="White" TextWrapping="Wrap"/>
                  <TextBlock x:Name="HomeStageGeneralStatus" Text="EKSİK" HorizontalAlignment="Left" Margin="0,3,0,0" FontWeight="Bold" FontSize="11" Foreground="#FFBF36"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,1">
                  <TextBlock x:Name="HomeProductCountText" Text="0" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Gold500Brush}"/>
                  <TextBlock Text=" ürün" VerticalAlignment="Bottom" Margin="3,0,0,3" Foreground="#B9CBDA" FontSize="11"/>
                </StackPanel>
                <TextBlock x:Name="HomeProductCountHintText" Text="En az 1 gerekli" Foreground="#91ABC0" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="HomeStageGeneralDetail" Text="İş başlığı ve ürünleri tamamlayın." TextWrapping="Wrap" Foreground="#B9CBDA" FontSize="10.8" Margin="0,3,0,5" MinHeight="28"/>
              </StackPanel>
            </Border>
            <Border Background="#111F36" BorderBrush="#8FC88B09" BorderThickness="1" CornerRadius="10" Margin="5,0" Padding="10">
              <StackPanel>
                <StackPanel>
                  <TextBlock Text="03  FİRMALAR / TEKLİFLER" FontWeight="Bold" FontSize="11.5" Foreground="White" TextWrapping="Wrap"/>
                  <TextBlock x:Name="HomeStageFirmsStatus" Text="EKSİK" HorizontalAlignment="Left" Margin="0,3,0,0" FontWeight="Bold" FontSize="11" Foreground="#FFBF36"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,1">
                  <TextBlock x:Name="HomeFirmCountText" Text="0" FontSize="20" FontWeight="Bold" Foreground="#7EE2A6"/>
                  <TextBlock Text=" firma" VerticalAlignment="Bottom" Margin="3,0,0,3" Foreground="#B9CBDA" FontSize="11"/>
                </StackPanel>
                <TextBlock x:Name="HomeFirmCountHintText" Text="En az 3 gerekli" Foreground="#91ABC0" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="HomeStageFirmsDetail" Text="Firma ve teklifleri tamamlayın." TextWrapping="Wrap" Foreground="#B9CBDA" FontSize="10.8" Margin="0,3,0,5" MinHeight="28"/>
              </StackPanel>
            </Border>
            <Border Background="#111F36" BorderBrush="#8FC88B09" BorderThickness="1" CornerRadius="10" Margin="5,0" Padding="10">
              <StackPanel>
                <StackPanel>
                  <TextBlock Text="04  TARİHLER" FontWeight="Bold" FontSize="11.5" Foreground="White" TextWrapping="Wrap"/>
                  <TextBlock x:Name="HomeStageDatesStatus" Text="EKSİK" HorizontalAlignment="Left" Margin="0,3,0,0" FontWeight="Bold" FontSize="11" Foreground="#FFBF36"/>
                </StackPanel>
                <TextBlock Text="Tarih ve belge düzeni" Foreground="#D8E8F5" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,4"/>
                <TextBlock x:Name="HomeStageDatesDetail" Text="Belge tarihlerini tamamlayın." TextWrapping="Wrap" Foreground="#B9CBDA" FontSize="10.8" Margin="0,3,0,7" MinHeight="47"/>
              </StackPanel>
            </Border>
            <Border Background="#111F36" BorderBrush="#8FC88B09" BorderThickness="1" CornerRadius="10" Margin="5,0,0,0" Padding="10">
              <StackPanel>
                <StackPanel>
                  <TextBlock Text="05  ÇIKTILAR" FontWeight="Bold" FontSize="11.5" Foreground="White" TextWrapping="Wrap"/>
                  <TextBlock x:Name="HomeStageOutputStatus" Text="EKSİK" HorizontalAlignment="Left" Margin="0,3,0,0" FontWeight="Bold" FontSize="11" Foreground="#FFBF36"/>
                </StackPanel>
                <TextBlock Text="Resmî belge hazırlığı" Foreground="#D8E8F5" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,4"/>
                <TextBlock x:Name="HomeStageOutputDetail" Text="Ön hazırlık ve nihai belgeleri kontrol edin." TextWrapping="Wrap" Foreground="#B9CBDA" FontSize="10.8" Margin="0,3,0,7" MinHeight="47"/>
              </StackPanel>
            </Border>
          </UniformGrid>
        </StackPanel>
      </Border>
      <!-- Mali özet -->
      <Grid Margin="0,0,0,8">
        <TextBlock Text="MALİ ÖZET" Foreground="{StaticResource MetricGold}" FontSize="17" FontWeight="Bold"/>
        <TextBlock Text="Firma teklifleri ve piyasa araştırması esas alınır" Foreground="{StaticResource PremiumMutedTextBrush}" FontSize="13.5" HorizontalAlignment="Right"/>
      </Grid>
      <UniformGrid Columns="4" Margin="0,0,0,12">
        <HeaderedContentControl Margin="0,0,4,0" Header="YAKLAŞIK MALİYET" Tag="{StaticResource MetricCoins}" Style="{StaticResource CalculationOverviewCard}">
          <StackPanel>
            <Border Style="{StaticResource OverviewWell}">
              <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                <TextBlock x:Name="HomeApproximateTotalText" Text="—" Foreground="#F4F6FB" FontSize="{StaticResource AtlasValueFontSize}" FontWeight="Bold" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" TextAlignment="Left"/>
              </Viewbox>
            </Border>
            <TextBlock Text="Firma ortalamaları" Foreground="{StaticResource PremiumMutedTextBrush}" FontSize="12.5" Margin="2,4,0,0"/>
          </StackPanel>
        </HeaderedContentControl>
        <HeaderedContentControl Margin="3,0" Header="NİHAİ TOPLAM" Tag="{StaticResource MetricTransfer}" Style="{StaticResource CalculationOverviewCard}">
          <StackPanel>
            <Border Style="{StaticResource OverviewWell}">
              <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                <TextBlock x:Name="HomeFinalTotalText" Text="—" Foreground="#F4F6FB" FontSize="{StaticResource AtlasValueFontSize}" FontWeight="Bold" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" TextAlignment="Left"/>
              </Viewbox>
            </Border>
            <TextBlock Text="En düşük toplam" Foreground="{StaticResource PremiumMutedTextBrush}" FontSize="12.5" Margin="2,4,0,0"/>
          </StackPanel>
        </HeaderedContentControl>
        <HeaderedContentControl Margin="3,0" Header="FARK" Tag="{StaticResource MetricShield}" Style="{StaticResource CalculationOverviewCard}">
          <StackPanel>
            <Border Style="{StaticResource OverviewWell}">
              <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                <TextBlock x:Name="HomeDifferenceText" Text="—" Foreground="#F4F6FB" FontSize="{StaticResource AtlasValueFontSize}" FontWeight="Bold" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" TextAlignment="Left"/>
              </Viewbox>
            </Border>
            <TextBlock x:Name="HomeDifferenceHintText" Text="Hesaplama bekleniyor" Foreground="{StaticResource PremiumMutedTextBrush}" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="2,4,0,0"/>
          </StackPanel>
        </HeaderedContentControl>
        <HeaderedContentControl Margin="4,0,0,0" Header="KAZANAN FİRMA" Tag="{StaticResource MetricBank}" Style="{StaticResource CalculationOverviewCard}">
          <StackPanel>
            <Border Style="{StaticResource OverviewWell}">
              <Viewbox StretchDirection="DownOnly">
                <TextBlock x:Name="HomeWinnerText" Text="Henüz yok" Foreground="#F4F6FB" FontSize="19" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
              </Viewbox>
            </Border>
            <TextBlock x:Name="HomeWinnerHintText" Text="Nihai teklifler bekleniyor" Foreground="{StaticResource PremiumMutedTextBrush}" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="2,4,0,0"/>
          </StackPanel>
        </HeaderedContentControl>
      </UniformGrid>
      <!-- Sıradaki önerilen adım -->
      <Border Style="{StaticResource PremiumPanel}" Padding="16,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="160"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="8" Height="8" Fill="{StaticResource Gold500Brush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Text="SIRADAKİ ÖNERİLEN ADIM" Foreground="{StaticResource Gold500Brush}" FontSize="11.5" FontWeight="Bold"/>
            </StackPanel>
            <TextBlock x:Name="HomeNextStepText" Text="İşlem bilgilerini tamamlayın." Foreground="White" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="16,4,20,0"/>
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
