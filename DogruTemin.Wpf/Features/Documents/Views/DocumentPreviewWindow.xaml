<Window x:Class="DogruTemin.Wpf.DocumentPreviewWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Icon="pack://application:,,,/DogruTemin;component/Assets/AppIcon.ico" Title="DoğruTemin — Canlı Belge Önizleme" Width="1320" Height="940"
 MinWidth="680" MinHeight="480" WindowStartupLocation="CenterOwner" Background="White">
 <Grid><Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition/></Grid.RowDefinitions>
 <Border Background="White" BorderBrush="#DEE5EC" BorderThickness="0,0,0,1" Padding="18,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
 <StackPanel><TextBlock Text="{Binding Name}" Foreground="#24354B" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Status}" Foreground="#64748B" FontSize="12" Margin="0,6,0,0"/></StackPanel>
 <StackPanel Grid.Column="1" Margin="10,0"><TextBlock Text="Yakınlaştır" Foreground="#24354B"/><Slider x:Name="Zoom" Minimum="0.5" Maximum="1.5" Value="0.9" SmallChange="0.1" Margin="0,10,0,0"/></StackPanel>
 <Button Grid.Column="2" Content="KAPAT" Style="{StaticResource WorkspaceAction}" Height="38" Background="#EEF2F6" Foreground="#24354B" Click="Close_Click"/></Grid></Border>
 <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="White" Padding="20">
 <Border Background="White" HorizontalAlignment="Center" VerticalAlignment="Top"><Border.LayoutTransform><ScaleTransform ScaleX="{Binding Value, ElementName=Zoom}" ScaleY="{Binding Value, ElementName=Zoom}"/></Border.LayoutTransform><Image Source="{Binding Image}" Width="1100" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/></Border>
 </ScrollViewer></Grid></Window>
