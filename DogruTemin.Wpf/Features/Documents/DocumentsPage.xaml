<?xml version='1.0' encoding='utf-8'?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DogruTemin.Wpf" xmlns:models="clr-namespace:DogruTemin.Wpf.Models" xmlns:shell="clr-namespace:DogruTemin.Wpf.Features.Shell" x:Class="DogruTemin.Wpf.Features.Documents.DocumentsPage">
  <ScrollViewer x:Name="DocumentsDatesView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,8,8">
      <TextBlock Text="TARİHLER" Style="{StaticResource PageTitle}" x:Name="DocumentsDatesPageTitle"/>
      <TextBlock Text="Belge tarihleri ve çıktılar tek sayfada yönetilir." Style="{StaticResource PageSubtitle}" Margin="2,0,0,6" x:Name="DocumentsDatesPageSubtitle"/>
      <StackPanel x:Name="DatesView">
        <Grid Margin="2,0,0,5">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="BELGE TARİHLERİ" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Style="{StaticResource ModernButton}" Content="TARİHLERİ KAYDET" Padding="14,7" Click="SaveDates_Click"/>
        </Grid>
        <Border Background="#FFF4D6" BorderBrush="#D7A21B" BorderThickness="1.5" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
          <TextBlock x:Name="ApprovalDateReferenceText" Text="Onay Belgesi tarihi: Henüz girilmedi" Foreground="#163B5C" FontSize="15" FontWeight="SemiBold"/>
        </Border>
        <Border Style="{StaticResource PremiumPanel}" Padding="12,10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition Width="20"/>
              <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="14"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="14"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0">
              <TextBlock Text="Komisyon Onay Tarihi" Style="{StaticResource PremiumFieldLabel}"/>
              <local:LargeDatePicker x:Name="AssignmentDatePicker" Grid.Column="1" SelectedDateChanged="AnyDate_Changed"/>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="2">
              <TextBlock Text="Harcama Belgesi Tarihi" Style="{StaticResource PremiumFieldLabel}"/>
              <local:LargeDatePicker x:Name="ApprovalDatePicker" Grid.Column="1" SelectedDateChanged="AnyDate_Changed"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="0">
              <TextBlock Text="Yaklaşık Maliyet Hesap Cetveli Tarihi" Style="{StaticResource PremiumFieldLabel}"/>
              <local:LargeDatePicker x:Name="CostCalculationDatePicker" SelectedDateChanged="AnyDate_Changed"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="2">
              <TextBlock Text="Piyasa Fiyat Araştırması Tutanağı Tarihi" Style="{StaticResource PremiumFieldLabel}"/>
              <local:LargeDatePicker x:Name="MarketReportDatePicker" SelectedDateChanged="AnyDate_Changed"/>
            </StackPanel>
            <StackPanel Grid.Row="4" Grid.Column="0">
              <TextBlock Text="Muayene ve Kabul Tutanağı Tarihi" Style="{StaticResource PremiumFieldLabel}"/>
              <local:LargeDatePicker x:Name="InspectionReportDatePicker" SelectedDateChanged="AnyDate_Changed"/>
            </StackPanel>
            <StackPanel Grid.Row="4" Grid.Column="2">
              <TextBlock Text="Teslim Alma / Kabul Tarihi" Style="{StaticResource PremiumFieldLabel}"/>
              <local:LargeDatePicker x:Name="DeliveryDatePicker" SelectedDateChanged="AnyDate_Changed"/>
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
      <Grid x:Name="OutputView" VerticalAlignment="Top">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="20"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <HeaderedContentControl Header="ÖN HAZIRLIK BELGELERİ" Tag="{StaticResource MetricAccrual}" Style="{StaticResource InsetFormCard}" Margin="0" Grid.Column="0" VerticalAlignment="Top">
          <StackPanel>
            <TextBlock Text="Yaklaşık Maliyet Talep Yazısı ve Firma Teklif Formu ayrı PDF dosyaları olarak hazırlanır." TextWrapping="Wrap" Foreground="{StaticResource PremiumMutedTextBrush}" FontSize="14" Margin="0,0,0,18" MinHeight="60"/>
            <Button Content="PDF" Tag="Preparation" Style="{StaticResource WorkspaceAction}" Width="140" Height="42" HorizontalAlignment="Left" Click="OutputGroupPdf_Click"/>
            <TextBlock x:Name="PreparationExportStatusText" Foreground="{StaticResource PremiumMutedTextBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
            <ItemsControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ItemsSource="{Binding PreparationPreviews}" Margin="0,16,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="2"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource DocumentThumbnailButton}" Click="DocumentThumbnail_Click" Tag="{Binding}" ToolTip="Büyütmek için tıklayın" AutomationProperties.Name="{Binding Name}">
                    <StackPanel>
                      <Border Background="White" Height="158" CornerRadius="4" Padding="4">
                        <Image Source="{Binding Image}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                      </Border>
                      <TextBlock Text="{Binding Name}" Foreground="#24354B" TextWrapping="Wrap" TextAlignment="Center" FontWeight="SemiBold" FontSize="12" Margin="0,10,0,0"/>
                      <TextBlock Text="{Binding Status}" Foreground="#64748B" TextWrapping="Wrap" TextAlignment="Center" FontSize="10" Margin="0,5,0,0"/>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </HeaderedContentControl>
        <HeaderedContentControl Header="NİHAİ İŞLEM BELGELERİ" Tag="{StaticResource MetricShield}" Style="{StaticResource InsetFormCard}" Margin="0" Grid.Column="2" VerticalAlignment="Top">
          <StackPanel>
            <TextBlock Text="Yaklaşık Maliyet Hesap Cetveli, Onay Belgesi, Piyasa Fiyat Araştırması Tutanağı ve Muayene ve Kabul Tutanağı ayrı PDF dosyaları olarak hazırlanır." TextWrapping="Wrap" Foreground="{StaticResource PremiumMutedTextBrush}" FontSize="14" Margin="0,0,0,18" MinHeight="60"/>
            <Button Content="PDF" Tag="Final" Style="{StaticResource WorkspaceAction}" Width="140" Height="42" HorizontalAlignment="Left" Click="OutputGroupPdf_Click"/>
            <TextBlock x:Name="FinalExportStatusText" Foreground="{StaticResource PremiumMutedTextBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
            <ItemsControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ItemsSource="{Binding FinalPreviews}" Margin="0,16,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="2"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource DocumentThumbnailButton}" Click="DocumentThumbnail_Click" Tag="{Binding}" ToolTip="Büyütmek için tıklayın" AutomationProperties.Name="{Binding Name}">
                    <StackPanel>
                      <Border Background="White" Height="158" CornerRadius="4" Padding="4">
                        <Image Source="{Binding Image}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                      </Border>
                      <TextBlock Text="{Binding Name}" Foreground="#24354B" TextWrapping="Wrap" TextAlignment="Center" FontWeight="SemiBold" FontSize="12" Margin="0,10,0,0"/>
                      <TextBlock Text="{Binding Status}" Foreground="#64748B" TextWrapping="Wrap" TextAlignment="Center" FontSize="10" Margin="0,5,0,0"/>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </HeaderedContentControl>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
