<?xml version='1.0' encoding='utf-8'?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DogruTemin.Wpf" xmlns:models="clr-namespace:DogruTemin.Wpf.Models" xmlns:shell="clr-namespace:DogruTemin.Wpf.Features.Shell" x:Class="DogruTemin.Wpf.Features.Documents.ApprovalPage">
  <ScrollViewer x:Name="ApprovalDocumentView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,8,4">
      <TextBlock Text="ONAY BELGESİ" Style="{StaticResource PageTitle}"/>
      <TextBlock Text="Referansta karşılığı dolu bilgiler zorunludur (*). Opsiyonel alanlar boş bırakılabilir; Açıklamalar boşsa İşin Tanımı otomatik kullanılır." Style="{StaticResource PageSubtitle}" Margin="2,0,0,10"/>
      <HeaderedContentControl Header="ÖDENEK / İHALE BİLGİLERİ" Tag="{StaticResource MetricCoins}" Style="{StaticResource InsetFormCard}" Margin="0,0,0,12">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition Width="20"/>
              <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="14"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="14"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0">
              <TextBlock Text="Kullanılabilir Ödenek Tutarı *" Style="{StaticResource PremiumFieldLabel}"/>
              <TextBox x:Name="ApprovalAvailableBudgetBox" Style="{StaticResource PremiumFieldTextBox}" TextChanged="AnyGlobalField_TextChanged"/>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="2">
              <TextBlock Text="Bütçe Tertibi *" Style="{StaticResource PremiumFieldLabel}"/>
              <TextBox x:Name="ApprovalBudgetCodeBox" Style="{StaticResource PremiumFieldTextBox}" TextChanged="AnyGlobalField_TextChanged"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="0">
              <TextBlock Text="İhale Usulü *" Style="{StaticResource PremiumFieldLabel}"/>
              <TextBox x:Name="ApprovalTenderProcedureBox" Style="{StaticResource PremiumFieldTextBox}" TextChanged="AnyGlobalField_TextChanged"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="2">
              <TextBlock Text="İlanın Şekli ve Adedi *" Style="{StaticResource PremiumFieldLabel}"/>
              <TextBox x:Name="ApprovalAnnouncementMethodBox" Style="{StaticResource PremiumFieldTextBox}" TextChanged="AnyGlobalField_TextChanged"/>
            </StackPanel>
            <StackPanel Grid.Row="4" Grid.Column="0">
              <TextBlock Text="Fiyat Farkı Ödenecekse Dayanağı *" Style="{StaticResource PremiumFieldLabel}"/>
              <TextBox x:Name="ApprovalPriceDifferenceBasisBox" Style="{StaticResource PremiumFieldTextBox}" TextChanged="AnyGlobalField_TextChanged"/>
            </StackPanel>
            <StackPanel Grid.Row="4" Grid.Column="2">
              <TextBlock Text="Onay Belgesi Tarihi" Style="{StaticResource PremiumFieldLabel}"/>
              <local:LargeDatePicker x:Name="ApprovalDocumentDatePicker" SelectedDateChanged="AnyDate_Changed"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </HeaderedContentControl>
      <Border Background="{StaticResource InsetCardSurface}" BorderBrush="{StaticResource SlateBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" x:Name="ApprovalAutomaticInfo" Margin="0,0,0,16">
        <Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <Border Background="{StaticResource MetricGold}" CornerRadius="1.5"/>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Bu bilgiler otomatik doldurulur" Foreground="{StaticResource MetricGold}" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBlock Foreground="{StaticResource PremiumMutedTextBrush}" FontSize="12" LineHeight="18" TextWrapping="Wrap" Text="Alım yapan idarenin adı, işin tanımı/niteliği, işin miktarı, KDV hariç yaklaşık maliyet, piyasa araştırma görevlileri, muayene ve kabul komisyonu ile harcama yetkilisi."/>
          </StackPanel>
        </Grid>
      </Border>
      <Expander x:Name="ApprovalOptionalFields" Header="Diğer bilgiler (isteğe bağlı)" IsExpanded="False" Style="{StaticResource WorkspaceExpander}" Margin="0,0,0,12">
        <StackPanel Margin="12">
          <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Belge Sayısı (Opsiyonel)" Style="{StaticResource PremiumFieldLabel}"/>
            <TextBox x:Name="ApprovalDocumentNumberBox" Style="{StaticResource PremiumFieldTextBox}" TextChanged="AnyGlobalField_TextChanged"/>
          </StackPanel>
          <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Yatırım Proje Numarası (Opsiyonel)" Style="{StaticResource PremiumFieldLabel}"/>
            <TextBox x:Name="ApprovalInvestmentProjectBox" Style="{StaticResource PremiumFieldTextBox}" TextChanged="AnyGlobalField_TextChanged"/>
          </StackPanel>
          <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Avans Verilecekse Şartları (Opsiyonel)" Style="{StaticResource PremiumFieldLabel}"/>
            <TextBox x:Name="ApprovalAdvanceConditionsBox" Style="{StaticResource PremiumFieldTextBox}" TextChanged="AnyGlobalField_TextChanged"/>
          </StackPanel>
          <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Ön Yeterlik / İhale Dokümanı Satış Bedeli (Opsiyonel)" Style="{StaticResource PremiumFieldLabel}"/>
            <TextBox x:Name="ApprovalPrequalificationSalePriceBox" Style="{StaticResource PremiumFieldTextBox}" TextChanged="AnyGlobalField_TextChanged"/>
          </StackPanel>
          <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Açıklamalar (Opsiyonel)" Style="{StaticResource PremiumFieldLabel}"/>
            <TextBox x:Name="ApprovalNotesBox" Style="{StaticResource PremiumFieldTextBox}" MinHeight="48" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" TextChanged="AnyGlobalField_TextChanged"/>
          </StackPanel>
        </StackPanel>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
