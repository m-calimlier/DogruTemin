<?xml version='1.0' encoding='utf-8'?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DogruTemin.Wpf" xmlns:models="clr-namespace:DogruTemin.Wpf.Models" xmlns:shell="clr-namespace:DogruTemin.Wpf.Features.Shell" x:Class="DogruTemin.Wpf.Features.Archive.ArchivePage">
  <Grid x:Name="ArchiveView" Visibility="Collapsed">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel>
        <TextBlock Text="İŞLEM ARŞİVİ" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="Geçmiş işlemleri arayın, filtreleyin, sıralayın ve çift tıklayarak hızla açın." Style="{StaticResource PageSubtitle}" Margin="2,2,0,0"/>
      </StackPanel>
      <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,10,0,0">
        <TextBlock x:Name="ArchiveCountText" Text="0 kayıt" Foreground="{StaticResource PremiumMutedTextBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0"/>
      </StackPanel>
    </Grid>
    <Border Grid.Row="1" Style="{StaticResource WorkspaceNote}" Padding="14,10" Margin="0,0,0,14">
      <StackPanel>
        <TextBlock Text="Her satır tek güncel işlemdir. Düzenle simgesiyle açın; değişiklik yaptıktan sonra Değişiklikleri Kaydet düğmesini kullanın. Klasör simgesi kayıtla eşleşen belgeleri açar. Değişen işlemin belgelerini yeniden üretin." Foreground="{StaticResource PremiumMutedTextBrush}" FontSize="13" TextWrapping="Wrap"/>
        <TextBlock x:Name="ArchiveWarningsText" Visibility="Collapsed" Foreground="#9D2933" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
      </StackPanel>
    </Border>
    <Border Grid.Row="2" Style="{StaticResource PremiumPanel}" Padding="14" Margin="0,0,0,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2.2*"/>
          <ColumnDefinition Width="20"/>
          <ColumnDefinition Width="1.15*"/>
          <ColumnDefinition Width="20"/>
          <ColumnDefinition Width="1.45*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="Hızlı Arama" Style="{StaticResource PremiumFieldLabel}"/>
          <TextBox x:Name="ArchiveSearchBox" Style="{StaticResource PremiumFieldTextBox}" VerticalContentAlignment="Center" TextChanged="ArchiveSearch_TextChanged" ToolTip="İşlem no, iş adı veya tarih yazın"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Göster" Style="{StaticResource PremiumFieldLabel}"/>
          <ComboBox x:Name="ArchiveFilterBox" Style="{StaticResource PremiumFieldComboBox}" SelectedIndex="0" SelectionChanged="ArchiveFilter_SelectionChanged">
            <ComboBoxItem Content="Tüm Kayıtlar" Style="{StaticResource PremiumComboBoxItem}"/>
            <ComboBoxItem Content="Yalnız Aktif İşlem" Style="{StaticResource PremiumComboBoxItem}"/>
            <ComboBoxItem Content="Aktif Olmayanlar" Style="{StaticResource PremiumComboBoxItem}"/>
          </ComboBox>
        </StackPanel>
        <StackPanel Grid.Column="4">
          <TextBlock Text="Sırala" Style="{StaticResource PremiumFieldLabel}"/>
          <ComboBox x:Name="ArchiveSortBox" Style="{StaticResource PremiumFieldComboBox}" SelectedIndex="0" SelectionChanged="ArchiveSort_SelectionChanged">
            <ComboBoxItem Content="Son Kaydedilen Önce" Style="{StaticResource PremiumComboBoxItem}"/>
            <ComboBoxItem Content="Eski Kaydedilen Önce" Style="{StaticResource PremiumComboBoxItem}"/>
            <ComboBoxItem Content="Harcama Tarihi - Yeni" Style="{StaticResource PremiumComboBoxItem}"/>
            <ComboBoxItem Content="İş Adı - A → Z" Style="{StaticResource PremiumComboBoxItem}"/>
            <ComboBoxItem Content="İşlem No" Style="{StaticResource PremiumComboBoxItem}"/>
          </ComboBox>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="3">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Border Style="{StaticResource PremiumPanel}" Padding="14">
        <DataGrid x:Name="ArchiveGrid" ItemsSource="{Binding ArchiveRecords}" Style="{StaticResource ArchiveSheet}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="All" CanUserAddRows="False" MouseDoubleClick="ArchiveGrid_MouseDoubleClick" RowHeight="{StaticResource AtlasRowHeight}" AlternatingRowBackground="#182943" GridLinesVisibility="All" HorizontalGridLinesBrush="#384C64" VerticalGridLinesBrush="#384C64" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" FrozenColumnCount="1">
          <DataGrid.Columns>
            <DataGridTextColumn ElementStyle="{StaticResource ArchiveSheetText}" Header="İŞLEM NO" Binding="{Binding OperationNumber}" Width="90" MinWidth="90"/>
            <DataGridTextColumn ElementStyle="{StaticResource ArchiveSheetText}" Header="İŞİN / ALIMIN ADI" Binding="{Binding JobTitle}" Width="*" MinWidth="150"/>
            <DataGridTextColumn ElementStyle="{StaticResource ArchiveSheetText}" Header="HARCAMA TARİHİ" SortMemberPath="ApprovalSortKey" Binding="{Binding ApprovalDate}" Width="105" MinWidth="105"/>
            <DataGridTextColumn ElementStyle="{StaticResource ArchiveSheetText}" Header="ÜRÜN / FİRMA" Binding="{Binding ScopeCounts}" Width="80" MinWidth="80"/>
            <DataGridTextColumn ElementStyle="{StaticResource ArchiveSheetText}" Header="SON KAYIT" SortMemberPath="LastSavedValue" Binding="{Binding LastSaved}" Width="120" MinWidth="120"/>
            <DataGridTextColumn ElementStyle="{StaticResource ArchiveSheetText}" Header="NİHAİ TUTAR" SortMemberPath="FinalTotalValue" Binding="{Binding FinalTotal}" Width="120" MinWidth="120"/>
            <DataGridTextColumn ElementStyle="{StaticResource ArchiveSheetText}" Header="BELGE DURUMU" Binding="{Binding OutputStatus}" Width="155" MinWidth="155"/>
            <DataGridTemplateColumn Header="İŞLEMLER" Width="235" MinWidth="235">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource RowEditAction}" Click="ArchiveRowEdit_Click" ToolTip="Kaydı düzenlemek için aç"/>
                    <Button Content="▣ Klasör" Width="70" Style="{StaticResource ArchiveRowAction}" Click="ArchiveRowFolder_Click"/>
                    <Button Style="{StaticResource RowDeleteAction}" Click="ArchiveRowDelete_Click"/>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Border>
      <StackPanel Grid.Row="1" Margin="0,12,0,0">
        <TextBlock Text="Kaydı çift tıklayarak açabilir veya satırdaki işlemleri kullanabilirsiniz." Foreground="{StaticResource PremiumMutedTextBrush}" FontSize="12.5" Margin="0,0,0,8"/>
        <WrapPanel HorizontalAlignment="Right"/>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
