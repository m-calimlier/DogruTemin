<?xml version='1.0' encoding='utf-8'?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="AtlasTokens.xaml"/>
  </ResourceDictionary.MergedDictionaries>
  <Color x:Key="Navy900">#0A1629</Color>
  <Color x:Key="Navy950">#0A1629</Color>
  <Color x:Key="Blue600">#2468D8</Color>
  <Color x:Key="Blue700">#1756B8</Color>
  <Color x:Key="Gold500">#DFBC70</Color>
  <Color x:Key="Gold600">#CDA858</Color>
  <Color x:Key="Danger500">#E53935</Color>
  <Color x:Key="Text900">#0A1629</Color>
  <Color x:Key="Text600">#526277</Color>
  <Color x:Key="Line200">#DCE3EC</Color>
  <Color x:Key="Surface">#F7F9FC</Color>
  <SolidColorBrush x:Key="Navy900Brush" Color="{StaticResource Navy900}"/>
  <SolidColorBrush x:Key="Navy950Brush" Color="{StaticResource Navy950}"/>
  <SolidColorBrush x:Key="Blue600Brush" Color="{StaticResource Blue600}"/>
  <SolidColorBrush x:Key="Blue700Brush" Color="{StaticResource Blue700}"/>
  <SolidColorBrush x:Key="Gold500Brush" Color="{StaticResource Gold500}"/>
  <SolidColorBrush x:Key="Gold600Brush" Color="{StaticResource Gold600}"/>
  <SolidColorBrush x:Key="Danger500Brush" Color="{StaticResource Danger500}"/>
  <SolidColorBrush x:Key="Text900Brush" Color="{StaticResource Text900}"/>
  <SolidColorBrush x:Key="Text600Brush" Color="{StaticResource Text600}"/>
  <SolidColorBrush x:Key="Line200Brush" Color="{StaticResource Line200}"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}"/>
  <SolidColorBrush x:Key="MetricGold" Color="#DFBC70"/>
  <SolidColorBrush x:Key="SlateBorderBrush" Color="#43566D"/>
  <SolidColorBrush x:Key="SlateInsetBorderBrush" Color="#43566D"/>
  <SolidColorBrush x:Key="SlateFieldBrush" Color="#0D1C30"/>
  <SolidColorBrush x:Key="InsetCardSurface" Color="#13263E"/>
  <!-- Barut Mavisi çalışma alanı -->
  <SolidColorBrush x:Key="PremiumPanelBrush" Color="#13263E"/>
  <SolidColorBrush x:Key="PremiumInputBrush" Color="#0D1C30"/>
  <SolidColorBrush x:Key="PremiumInputBorderBrush" Color="#43566D"/>
  <SolidColorBrush x:Key="PremiumTextBrush" Color="#EDF1F6"/>
  <SolidColorBrush x:Key="PremiumMutedTextBrush" Color="#ACBBCC"/>
  <SolidColorBrush x:Key="PremiumGoldBorderBrush" Color="#43566D"/>
  <!-- Aşama 2.2: uygulama genelinde tipografi standardı -->
  <!-- Aşama 2.4: tüm metinler kontrol alanında dikey olarak ortalanır -->
  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="{StaticResource AtlasBodyFontSize}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <!-- Explicit alan stilleri dahil tüm TextBox/ComboBox türevleri aynı dikey merkez standardını kullanır. -->
  <Style TargetType="TextBox">
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="{StaticResource AtlasBodyFontSize}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="{StaticResource AtlasBodyFontSize}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style x:Key="StandardButtonBase" TargetType="Button">
    <Setter Property="Height" Value="36"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style x:Key="ModernButton" TargetType="Button" BasedOn="{StaticResource StandardButtonBase}">
    <Setter Property="Foreground" Value="#0A1629"/>
    <Setter Property="Background" Value="{StaticResource AtlasGoldBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock">
                  <Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"/>
                  <Setter Property="FontFamily" Value="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Button}}"/>
                  <Setter Property="FontWeight" Value="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}"/>
                  <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                  <Setter Property="VerticalAlignment" Value="Center"/>
                </Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Opacity" Value="0.88"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Opacity" Value="0.72"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Height" Value="{StaticResource AtlasFieldHeight}"/>
    <Setter Property="MinHeight" Value="{StaticResource AtlasFieldHeight}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <!-- R13: tüm ana paneller için ortak tipografi standardı -->
  <Style x:Key="PageTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="25"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource PremiumTextBrush}"/>
    <Setter Property="Margin" Value="2,0,0,3"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
  </Style>
  <Style x:Key="PageSubtitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Foreground" Value="{StaticResource PremiumMutedTextBrush}"/>
    <Setter Property="Margin" Value="2,6,0,20"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
  </Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource MetricGold}"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
  </Style>
  <Style x:Key="SectionSubtitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Foreground" Value="{StaticResource PremiumMutedTextBrush}"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
  </Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Foreground" Value="{StaticResource PremiumMutedTextBrush}"/>
    <Setter Property="Margin" Value="0,0,0,7"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
  </Style>
  <Style x:Key="FieldTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="Background" Value="{StaticResource AtlasFieldBrush}"/>
    <Setter Property="Foreground" Value="#EDF1F6"/>
    <Setter Property="BorderBrush" Value="{StaticResource AtlasLineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Height" Value="{StaticResource AtlasFieldHeight}"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="{StaticResource AtlasBodyFontSize}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource AtlasFieldRadius}" SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource Blue600Brush}"/>
              <Setter TargetName="Border" Property="BorderThickness" Value="1.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="FieldComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
    <Setter Property="Background" Value="{StaticResource AtlasFieldBrush}"/>
    <Setter Property="Foreground" Value="#EDF1F6"/>
    <Setter Property="BorderBrush" Value="{StaticResource AtlasLineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="{StaticResource AtlasBodyFontSize}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Height" Value="{StaticResource AtlasFieldHeight}"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <!-- Büyük ve rahat tarih seçimi -->
  <Style x:Key="LargeCalendarStyle" TargetType="Calendar">
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="Width" Value="360"/>
    <Setter Property="Height" Value="330"/>
    <Setter Property="Background" Value="White"/>
    <Setter Property="Foreground" Value="{StaticResource Text900Brush}"/>
  </Style>
  <Style x:Key="FieldDatePicker" TargetType="DatePicker">
    <Setter Property="Background" Value="White"/>
    <Setter Property="Foreground" Value="{StaticResource Text900Brush}"/>
    <Setter Property="BorderBrush" Value="#D2DBE7"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontSize" Value="15.5"/>
    <Setter Property="Height" Value="{StaticResource AtlasFieldHeight}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="CalendarStyle" Value="{StaticResource LargeCalendarStyle}"/>
  </Style>
  <Style x:Key="ModernDataGridHeader" TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="{StaticResource AtlasFieldBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource PremiumMutedTextBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="BorderBrush" Value="#284660"/>
    <Setter Property="BorderThickness" Value="0,0,1,0"/>
    <Setter Property="Height" Value="{StaticResource AtlasFieldHeight}"/>
  </Style>
  <Style x:Key="ModernDataGridRow" TargetType="DataGridRow">
    <Setter Property="Background" Value="White"/>
    <Setter Property="Foreground" Value="{StaticResource Text900Brush}"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="BorderBrush" Value="#E2E8F0"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="#E9F2FF"/>
        <Setter Property="Foreground" Value="#0B1830"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="ModernDataGridCell" TargetType="DataGridCell">
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="10,5"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <!-- Ortak tablo hücre metni: DataGridTextColumn kendi TextBlock'ını ürettiği için
             dikey ortalamayı doğrudan TextBlock seviyesinde garanti eder. -->
  <Style x:Key="GridCellText" TargetType="TextBlock">
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextAlignment" Value="Left"/>
    <Setter Property="FontWeight" Value="Normal"/>
  </Style>
  <Style x:Key="GridCellTextWrap" TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="GridCellEditTextBox" TargetType="TextBox" BasedOn="{StaticResource FieldTextBox}">
    <Setter Property="Height" Value="{StaticResource AtlasFieldHeight}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Padding" Value="9,0"/>
  </Style>
  <Style x:Key="ModernDataGrid" TargetType="DataGrid">
    <Setter Property="Background" Value="{StaticResource AtlasPanelBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource AtlasLineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="GridLinesVisibility" Value="Horizontal"/>
    <Setter Property="HorizontalGridLinesBrush" Value="#E6EBF1"/>
    <Setter Property="HeadersVisibility" Value="Column"/>
    <Setter Property="CanUserAddRows" Value="False"/>
    <Setter Property="CanUserResizeRows" Value="False"/>
    <Setter Property="ColumnHeaderStyle" Value="{StaticResource ModernDataGridHeader}"/>
    <Setter Property="RowStyle" Value="{StaticResource ModernDataGridRow}"/>
    <Setter Property="CellStyle" Value="{StaticResource ModernDataGridCell}"/>
    <Setter Property="RowHeight" Value="{StaticResource AtlasRowHeight}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="AlternatingRowBackground" Value="{StaticResource AtlasAlternateRowBrush}"/>
  </Style>
  <!-- R17 premium panel bileşenleri -->
  <Style x:Key="PremiumPanel" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource AtlasPanelBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource AtlasLineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource AtlasCardRadius}"/>
    <Setter Property="Effect" Value="{x:Null}"/>
  </Style>
  <Style x:Key="PremiumSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
    <Setter Property="Foreground" Value="{StaticResource MetricGold}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="14"/>
  </Style>
  <Style x:Key="PremiumSectionSubtitle" TargetType="TextBlock" BasedOn="{StaticResource SectionSubtitle}">
    <Setter Property="Foreground" Value="{StaticResource PremiumMutedTextBrush}"/>
  </Style>
  <Style x:Key="PremiumFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
    <Setter Property="Foreground" Value="{StaticResource PremiumMutedTextBrush}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Margin" Value="0,0,0,7"/>
  </Style>
  <!-- R18: Premium giriş kontrollerinin normal / hover / focus / seçim durumları
             sistem temasına bırakılmaz. Böylece odak veya çift tıklamada açık zemin + açık yazı oluşmaz. -->
  <Style x:Key="PremiumFieldTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="Background" Value="{StaticResource AtlasFieldBrush}"/>
    <Setter Property="Foreground" Value="#EDF1F6"/>
    <Setter Property="BorderBrush" Value="{StaticResource AtlasLineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Height" Value="{StaticResource AtlasFieldHeight}"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="{StaticResource AtlasBodyFontSize}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="CaretBrush" Value="{StaticResource Gold500Brush}"/>
    <Setter Property="SelectionBrush" Value="#2D6593"/>
    <Setter Property="SelectionOpacity" Value="0.9"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="PremiumTextBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource AtlasFieldRadius}" SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="PremiumTextBorder" Property="BorderBrush" Value="#4D7595"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="PremiumTextBorder" Property="Background" Value="#23374E"/>
              <Setter TargetName="PremiumTextBorder" Property="BorderBrush" Value="{StaticResource Gold500Brush}"/>
              <Setter TargetName="PremiumTextBorder" Property="BorderThickness" Value="1.5"/>
              <Setter Property="Foreground" Value="White"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="PremiumTextBorder" Property="Background" Value="#17334D"/>
              <Setter Property="Foreground" Value="#91A8BC"/>
              <Setter Property="Opacity" Value="0.82"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="PremiumComboBoxItem" TargetType="ComboBoxItem">
    <Setter Property="Background" Value="#23374E"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="PremiumComboItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="PremiumComboItemBorder" Property="Background" Value="#16466F"/>
              <Setter Property="Foreground" Value="White"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="PremiumComboItemBorder" Property="Background" Value="#1756B8"/>
              <Setter Property="Foreground" Value="White"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsSelected" Value="True"/>
                <Condition Property="IsHighlighted" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="PremiumComboItemBorder" Property="Background" Value="#2468D8"/>
              <Setter Property="Foreground" Value="White"/>
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="#8298AA"/>
              <Setter Property="Opacity" Value="0.7"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="PremiumFieldComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
    <Setter Property="Background" Value="{StaticResource AtlasFieldBrush}"/>
    <Setter Property="Foreground" Value="#EDF1F6"/>
    <Setter Property="BorderBrush" Value="{StaticResource AtlasLineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Height" Value="{StaticResource AtlasFieldHeight}"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="{StaticResource AtlasBodyFontSize}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource PremiumComboBoxItem}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <Border x:Name="PremiumComboBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource AtlasFieldRadius}" SnapsToDevicePixels="True">
              <Grid>
                <ContentPresenter Margin="10,0,40,0" VerticalAlignment="Center" HorizontalAlignment="Left" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" IsHitTestVisible="False"/>
                <ToggleButton x:Name="DropDownToggle" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                  <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                      <Border Background="Transparent">
                        <Path x:Name="Arrow" Data="M 0 0 L 5 5 L 10 0" Stroke="#D8E4EF" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource Gold500Brush}"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </ToggleButton.Template>
                </ToggleButton>
              </Grid>
            </Border>
            <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
              <Border Background="#061F3B" BorderBrush="{StaticResource PremiumGoldBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource AtlasFieldRadius}" Margin="0,4,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="280">
                <ScrollViewer Margin="1" SnapsToDevicePixels="True" CanContentScroll="True">
                  <ItemsPresenter/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="PremiumComboBorder" Property="BorderBrush" Value="#4D7595"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="PremiumComboBorder" Property="Background" Value="#23374E"/>
              <Setter TargetName="PremiumComboBorder" Property="BorderBrush" Value="{StaticResource Gold500Brush}"/>
              <Setter TargetName="PremiumComboBorder" Property="BorderThickness" Value="1.5"/>
              <Setter Property="Foreground" Value="White"/>
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
              <Setter TargetName="PremiumComboBorder" Property="Background" Value="#23374E"/>
              <Setter TargetName="PremiumComboBorder" Property="BorderBrush" Value="{StaticResource Gold500Brush}"/>
            </Trigger>
            <Trigger Property="HasItems" Value="False">
              <Setter TargetName="PART_Popup" Property="MinHeight" Value="40"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="PremiumComboBorder" Property="Background" Value="#17334D"/>
              <Setter Property="Foreground" Value="#91A8BC"/>
              <Setter Property="Opacity" Value="0.82"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="PremiumDataGridHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModernDataGridHeader}">
    <Setter Property="ContentTemplate">
      <Setter.Value>
        <DataTemplate>
          <TextBlock Text="{Binding}" FontSize="12.5" Foreground="White" TextWrapping="Wrap" TextAlignment="Center" Margin="3,0"/>
        </DataTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Background" Value="{StaticResource AtlasFieldBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource PremiumMutedTextBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource PremiumGoldBorderBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,1,2"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Height" Value="{StaticResource AtlasFieldHeight}"/>
  </Style>
  <Style x:Key="PremiumDataGridRow" TargetType="DataGridRow" BasedOn="{StaticResource ModernDataGridRow}">
    <Setter Property="Background" Value="{StaticResource AtlasPanelBrush}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderBrush" Value="#384C64"/>
    <Style.Triggers>
      <Trigger Property="ItemsControl.AlternationIndex" Value="1">
