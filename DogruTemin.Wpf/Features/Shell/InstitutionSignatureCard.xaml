<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="DogruTemin.Wpf.Features.Shell.InstitutionSignatureCard">
  <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
    <Border Width="620" Height="412" Background="#142640" BorderBrush="#637D97" BorderThickness="3" CornerRadius="32">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="150"/>
          <RowDefinition/>
        </Grid.RowDefinitions>
        <Border Background="#23374E" CornerRadius="29,29,0,0">
          <Grid Margin="35,24">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="64"/>
              <ColumnDefinition Width="20"/>
              <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Viewbox Width="64" Height="64" VerticalAlignment="Center">
              <Path Stroke="#D4B064" StrokeThickness="1.3" StrokeLineJoin="Round" Data="M2,10 L16,2 30,10 Z M4,28 L28,28 M7,12 L7,25 M13,12 L13,25 M19,12 L19,25 M25,12 L25,25 M3,31 L29,31"/>
            </Viewbox>
            <TextBlock x:Name="SignatureInstitution" Grid.Column="2" Text="Sivaslı İlçe Milli Eğitim&#x0a;Müdürlüğü" Foreground="#CAD5E0" FontFamily="Segoe UI" FontSize="34" LineHeight="43" VerticalAlignment="Center"/>
          </Grid>
        </Border>
        <StackPanel Grid.Row="1" Margin="35,32,35,0">
          <TextBlock x:Name="SignatureApplication" Text="DoğruTemin" Foreground="#F5F6FB" FontFamily="Segoe UI" FontSize="36" FontWeight="SemiBold" Height="105"/>
          <Border Height="3" Background="#776444" Margin="0,14,0,28"/>
          <TextBlock x:Name="SignatureAuthor" Text="Created by Murat ÇALIMLIER" Foreground="#E8C778" FontFamily="Segoe UI" FontSize="34" FontWeight="SemiBold"/>
        </StackPanel>
      </Grid>
    </Border>
  </Viewbox>
</UserControl>
