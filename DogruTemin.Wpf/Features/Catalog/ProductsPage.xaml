<?xml version='1.0' encoding='utf-8'?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DogruTemin.Wpf" xmlns:models="clr-namespace:DogruTemin.Wpf.Models" xmlns:shell="clr-namespace:DogruTemin.Wpf.Features.Shell" x:Class="DogruTemin.Wpf.Features.Catalog.ProductsPage">
  <ScrollViewer x:Name="GeneralView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <TextBlock Text="MAL / HİZMET BİLGİSİ" Style="{StaticResource PageTitle}"/>
      <TextBlock Text="İş başlığı, mal/hizmet kalemleri ve görevlendirme / harcama belgesi bilgilerini yönetin." Style="{StaticResource PageSubtitle}" Margin="2,0,0,18"/>
      <HeaderedContentControl Header="ALIM BİLGİLERİ" Tag="{StaticResource MetricAccrual}" Style="{StaticResource InsetFormCard}" Margin="0,0,0,10">
        <StackPanel>
          <TextBlock Text="ALIM / İŞ BAŞLIĞI" Style="{StaticResource PremiumFieldLabel}" Margin="0"/>
          <TextBox x:Name="JobTitleBox" Style="{StaticResource PremiumFieldTextBox}" Text="" TextChanged="AnyGlobalField_TextChanged"/>
        </StackPanel>
      </HeaderedContentControl>
      <Grid x:Name="AtlasProductLayout">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="0.85*"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition Width="1.25*"/>
        </Grid.ColumnDefinitions>
        <HeaderedContentControl x:Name="AtlasProductEditor" Header="MAL / HİZMET GİRİŞİ" Tag="{StaticResource InsetLedgerIcon}" Style="{StaticResource InsetFormCard}" VerticalAlignment="Top">
          <StackPanel>
            <StackPanel Margin="0,0,0,10">
              <TextBlock Text="Mal / Hizmet Adı" Style="{StaticResource PremiumFieldLabel}"/>
              <TextBox x:Name="ProductNameBox" Style="{StaticResource PremiumFieldTextBox}" TextChanged="TransientProductEditor_TextChanged"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Özelliği" Style="{StaticResource PremiumFieldLabel}"/>
                <TextBox x:Name="ProductSpecBox" Style="{StaticResource PremiumFieldTextBox}" TextChanged="TransientProductEditor_TextChanged"/>
              </StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Miktarı" Style="{StaticResource PremiumFieldLabel}"/><TextBox x:Name="ProductQuantityBox" Style="{StaticResource PremiumFieldTextBox}" Text="1" TextChanged="TransientProductEditor_TextChanged"/></StackPanel><StackPanel Margin="0" Grid.Column="2">
                <TextBlock Text="Birimi" Style="{StaticResource PremiumFieldLabel}"/>
                <ComboBox x:Name="ProductUnitBox" Style="{StaticResource PremiumFieldComboBox}" SelectedIndex="0" SelectionChanged="TransientProductEditor_SelectionChanged">
                  <ComboBoxItem Content="Adet" Style="{StaticResource PremiumComboBoxItem}"/>
                  <ComboBoxItem Content="kg" Style="{StaticResource PremiumComboBoxItem}"/>
                  <ComboBoxItem Content="Litre" Style="{StaticResource PremiumComboBoxItem}"/>
                  <ComboBoxItem Content="Paket" Style="{StaticResource PremiumComboBoxItem}"/>
                  <ComboBoxItem Content="Bidon" Style="{StaticResource PremiumComboBoxItem}"/>
                  <ComboBoxItem Content="Koli" Style="{StaticResource PremiumComboBoxItem}"/>
                  <ComboBoxItem Content="Takım" Style="{StaticResource PremiumComboBoxItem}"/>
                  <ComboBoxItem Content="Çift" Style="{StaticResource PremiumComboBoxItem}"/>
                  <ComboBoxItem Content="Metre" Style="{StaticResource PremiumComboBoxItem}"/>
                </ComboBox>
              </StackPanel>
              </Grid><TextBlock Text="Mal/hizmet adı ve miktar zorunludur." Foreground="{StaticResource AtlasAccentBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/><Button x:Name="ProductActionButton" Style="{StaticResource WorkspaceAction}" Content="EKLE" Width="120" Margin="0,10,0,0" Click="AddOrUpdateProduct_Click" HorizontalAlignment="Right"/>
          </StackPanel>
        </HeaderedContentControl>
        <HeaderedContentControl x:Name="AtlasProductList" Grid.Column="2" Header="MAL / HİZMET KALEMLERİ" Tag="{StaticResource MetricAccrual}" Style="{StaticResource InsetFormCard}" VerticalAlignment="Top">
          <StackPanel>
            <DataGrid x:Name="ProductGrid" Style="{StaticResource PremiumDataGrid}" ItemsSource="{Binding Products}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" RowHeight="{StaticResource AtlasRowHeight}" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Height="310">
              <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding No}" Width="45" ElementStyle="{StaticResource PremiumGridCellText}"/>
                <DataGridTextColumn Header="Mal / Hizmet Adı" Binding="{Binding Name}" Width="2.0*" ElementStyle="{StaticResource PremiumGridCellText}"/>
                <DataGridTextColumn Header="Özelliği" Binding="{Binding Specification}" Width="1.5*" ElementStyle="{StaticResource PremiumGridCellText}"/>
                <DataGridTextColumn Header="Birimi" Binding="{Binding Unit}" Width="100" ElementStyle="{StaticResource PremiumGridCellText}"/>
                <DataGridTextColumn Header="Miktarı" Binding="{Binding Quantity}" Width="100" ElementStyle="{StaticResource PremiumGridCellText}"/>
                <DataGridTemplateColumn Header="İşlemler" Width="115" MinWidth="115">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Style="{StaticResource RowEditAction}" Margin="0,0,7,0" ToolTip="Mal/hizmet kalemini düzenle" AutomationProperties.Name="Mal/hizmet kalemini düzenle" Click="ProductEdit_Click" Tag="{Binding}"/>
                        <Button Style="{StaticResource RowDeleteAction}" ToolTip="Mal/hizmet kalemini sil" AutomationProperties.Name="Mal/hizmet kalemini sil" Click="ProductDelete_Click" Tag="{Binding}"/>
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="ProductCountText" Text="2 / 10 ürün" HorizontalAlignment="Right" Foreground="{StaticResource AtlasAccentBrush}" Margin="0,9,2,0"/>
          </StackPanel>
        </HeaderedContentControl>
      </Grid>
      <Border Style="{StaticResource PremiumPanel}" Padding="14" Margin="0,10,0,0">
        <StackPanel>
          <DockPanel Margin="0,0,0,14">
            <Border DockPanel.Dock="Left" Style="{StaticResource InsetCardPlate}" Width="30" Height="30" Margin="0,0,8,0">
              <Image Source="{StaticResource MetricAccrual}" Width="18" Height="18"/>
            </Border>
            <TextBlock Text="GÖREVLENDİRME / HARCAMA BELGESİ" Style="{StaticResource PremiumSectionTitle}"/>
          </DockPanel>
          <Grid>
            <Grid MaxWidth="650" HorizontalAlignment="Left">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="225"/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Harcama Belgesi Sayısı" Style="{StaticResource PremiumFieldLabel}" Margin="0"/>
              <TextBox x:Name="ApprovalNoBox" Grid.Column="1" Style="{StaticResource PremiumFieldTextBox}" TextChanged="AnyGlobalField_TextChanged" LostFocus="ApprovalNoBox_LostFocus"/>
            </Grid>
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
