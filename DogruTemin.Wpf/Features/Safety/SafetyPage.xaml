<?xml version='1.0' encoding='utf-8'?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DogruTemin.Wpf" xmlns:models="clr-namespace:DogruTemin.Wpf.Models" xmlns:shell="clr-namespace:DogruTemin.Wpf.Features.Shell" x:Class="DogruTemin.Wpf.Features.Safety.SafetyPage">
  <ScrollViewer x:Name="AboutSafetyView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,8,18">
      <TextBlock Text="HAKKINDA / GÜVENLİK" Style="{StaticResource PageTitle}"/>
      <TextBlock Text="Uygulama bilgileri ve kayıtlarınızı korumak için ihtiyaç duyduğunuz araçlar." Style="{StaticResource PageSubtitle}"/>
      <Border Style="{StaticResource PremiumPanel}" Padding="24" Margin="0,0,0,16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="64"/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <Border Width="48" Height="48" Background="#204B6A" CornerRadius="12" VerticalAlignment="Top">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="25" Foreground="#FFD479" VerticalAlignment="Center" HorizontalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1">
            <TextBlock x:Name="AboutVersionText" FontSize="23" FontWeight="SemiBold" Foreground="White"/>
            <TextBlock Text="Doğrudan Temin Süreç Yönetim Programı" FontSize="14" Foreground="#D7E4EF" Margin="0,5,0,10"/>
            <TextBlock x:Name="AboutRuntimeText" FontSize="13" Foreground="#B2C8DA" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border Background="#EFF8F3" BorderBrush="#C8E2D3" BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,0,0,16">
        <StackPanel>
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource ModernButton}" Content="KONTROL ET" Width="135" Height="42" Margin="16,0,0,0" Click="RunIntegrityCheck_Click"/>
            <StackPanel>
              <TextBlock Text="Veri bütünlüğü" Foreground="#163D30" FontSize="20" FontWeight="SemiBold"/>
              <TextBlock x:Name="DataIntegrityText" FontSize="14" TextWrapping="Wrap" Margin="0,8,0,0"/>
              <TextBlock x:Name="LastIntegrityCheckText" FontSize="12" Foreground="#537565" Margin="0,8,0,0"/>
            </StackPanel>
          </DockPanel>
        </StackPanel>
      </Border>
      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition Width="20"/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource PremiumPanel}" Padding="22">
          <StackPanel>
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Foreground="#FFD479" FontSize="27" Margin="0,0,0,14"/>
            <TextBlock Text="Güvenlik yedeği" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
            <TextBlock Text="Kayıtlarınızın bir kopyasını oluşturarak çalışmalarınızı koruyun." TextWrapping="Wrap" Foreground="#C5D8E8" FontSize="14" Margin="0,8,0,18" MinHeight="44"/>
            <Button Style="{StaticResource ModernButton}" Content="YEDEK OLUŞTUR" Width="200" Height="44" HorizontalAlignment="Left" Click="CreateSafetyBackup_Click"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource PremiumPanel}" Padding="22">
          <StackPanel>
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Foreground="#FFD479" FontSize="27" Margin="0,0,0,14"/>
            <TextBlock Text="Yedekten geri yükle" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
            <TextBlock Text="Önceki bir yedeğe dönün. Mevcut veriler değiştirilmeden önce onayınız alınır." TextWrapping="Wrap" Foreground="#C5D8E8" FontSize="14" Margin="0,8,0,18" MinHeight="44"/>
            <Button Style="{StaticResource ModernButton}" Content="YEDEK SEÇ VE GERİ YÜKLE" Width="240" Height="44" HorizontalAlignment="Left" Background="#8A5A12" Click="RestoreSafetyBackup_Click"/>
          </StackPanel>
        </Border>
      </Grid>
      <Border Style="{StaticResource InsetCardShell}" Padding="22">
        <StackPanel>
          <TextBlock Text="Klasörler ve destek" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource MetricGold}"/>
          <TextBlock Text="VERİ KONUMU" Foreground="{StaticResource PremiumMutedTextBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,16,0,5"/>
          <TextBlock x:Name="AboutDataFolderText" Foreground="{StaticResource PremiumMutedTextBrush}" FontSize="13" TextWrapping="Wrap"/>
          <WrapPanel Margin="0,16,0,0">
            <Button Style="{StaticResource ModernButton}" Content="VERİ KLASÖRÜ" Width="150" Height="42" Margin="0,0,8,8" Background="#385C79" Click="OpenDataFolder_Click"/>
            <Button Style="{StaticResource ModernButton}" Content="YEDEK KLASÖRÜ" Width="160" Height="42" Margin="0,0,8,8" Background="#385C79" Click="OpenBackupFolder_Click"/>
            <Button Style="{StaticResource ModernButton}" Content="LOG KLASÖRÜ" Width="145" Height="42" Margin="0,0,8,8" Background="#385C79" Click="OpenLogFolder_Click"/>
            <Button Style="{StaticResource ModernButton}" Content="TANILAMA PAKETİ" Width="180" Height="42" Margin="0,0,8,8" Background="#385C79" Click="CreateDiagnosticPackage_Click"/>
          </WrapPanel>
          <TextBlock Text="Tanılama paketi işlem verilerinizi ve PDF belgelerinizi içermez." TextWrapping="Wrap" Foreground="{StaticResource PremiumMutedTextBrush}" FontSize="13" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
