<?xml version='1.0' encoding='utf-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DogruTemin.Wpf" xmlns:models="clr-namespace:DogruTemin.Wpf.Models" xmlns:shell="clr-namespace:DogruTemin.Wpf.Features.Shell" xmlns:workspace="clr-namespace:DogruTemin.Wpf.Features.Workspace" xmlns:catalog="clr-namespace:DogruTemin.Wpf.Features.Catalog" xmlns:documents="clr-namespace:DogruTemin.Wpf.Features.Documents" xmlns:institution="clr-namespace:DogruTemin.Wpf.Features.Institution" xmlns:statistics="clr-namespace:DogruTemin.Wpf.Features.Statistics" xmlns:archive="clr-namespace:DogruTemin.Wpf.Features.Archive" xmlns:safety="clr-namespace:DogruTemin.Wpf.Features.Safety" xmlns:offers="clr-namespace:DogruTemin.Wpf.Features.Offers" x:Class="DogruTemin.Wpf.MainWindow" Icon="Assets/AppIcon.ico" Title="DoğruTemin - Doğrudan Temin Süreç Yönetim Programı" Width="1920" Height="1080" SizeToContent="Manual" ResizeMode="CanResizeWithGrip" MinWidth="760" MinHeight="520" WindowStartupLocation="Manual" WindowStyle="None" ShowInTaskbar="True" Background="{StaticResource Navy900Brush}" UseLayoutRounding="True" SnapsToDevicePixels="True" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown" StateChanged="Window_StateChanged">
  <Grid x:Name="AppScaleViewbox">
    <Border CornerRadius="15" BorderBrush="#35546F" BorderThickness="1" Background="#0B162B" Margin="8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="68"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="{StaticResource AtlasSidebarWidth}"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- ÜST BAR -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2" Background="#0B162B" MouseLeftButtonDown="Header_MouseLeftButtonDown">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource AtlasSidebarWidth}"/>
            <ColumnDefinition x:Name="HeaderStatusColumn" Width="220"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
            <Image Source="Assets/Logo.png" Width="140" Height="52" Stretch="Uniform"/>
          </StackPanel>
          <StackPanel x:Name="HeaderSaveStatus" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0,0,0">
            <Border Background="#23374E" CornerRadius="9" BorderBrush="#384C64" BorderThickness="1" Padding="13,8" Margin="0" Width="188">
              <StackPanel>
                <TextBlock Text="KAYIT DURUMU" Foreground="#8FA8C0" FontSize="10" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                  <Ellipse x:Name="SaveStatusDot" Width="9" Height="9" Fill="#43C77A" VerticalAlignment="Center" Margin="0,0,7,0"/>
                  <TextBlock x:Name="SaveStatusText" Text="Kaydedildi" Foreground="#DDF6E7" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
          <Grid Grid.Column="2" VerticalAlignment="Center" Margin="8,0,14,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="122" x:Name="HeaderReadinessColumn"/>
              <ColumnDefinition Width="44"/>
              <ColumnDefinition Width="44"/>
              <ColumnDefinition Width="44"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="HeaderActiveOperation" Grid.Column="0" Background="#23374E" BorderBrush="#384C64" BorderThickness="1" CornerRadius="9" Padding="12,7" MinWidth="150">
              <StackPanel>
                <TextBlock Text="AKTİF İŞLEM" Foreground="#8FA8C0" FontSize="10" FontWeight="SemiBold"/>
                <TextBlock x:Name="ActiveOperationText" Text="Yeni İşlem" Foreground="White" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
              </StackPanel>
            </Border>
            <StackPanel x:Name="HeaderReadiness" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <StackPanel VerticalAlignment="Center" Margin="0,0,7,0">
                <TextBlock Text="HAZIRLIK" Foreground="#8FA8C0" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                <TextBlock Text="DURUMU" Foreground="#C3CFDC" FontSize="10.5" HorizontalAlignment="Right"/>
              </StackPanel>
              <Grid Width="48" Height="48">
                <Ellipse Stroke="#29445F" StrokeThickness="5"/>
                <Path x:Name="HeaderReadinessArc" Stroke="#F4C45E" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M24,4 A20,20 0 1 1 4,24"/>
                <TextBlock x:Name="HeaderReadinessText" Text="%0" Foreground="White" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
            </StackPanel>
            <Button Grid.Column="3" Content="—" ToolTip="Küçült" FontSize="21" FontWeight="SemiBold" Foreground="White" Background="Transparent" BorderThickness="0" Width="44" Height="48" Cursor="Hand" Click="Minimize_Click"/>
            <Button x:Name="MaximizeRestoreButton" Grid.Column="4" ToolTip="Tam ekran" Foreground="White" Background="Transparent" BorderThickness="0" Width="44" Height="48" Cursor="Hand" Click="MaximizeRestore_Click">
              <TextBlock x:Name="MaximizeRestoreIcon" FontFamily="Segoe MDL2 Assets" Text="" FontSize="15" FontWeight="SemiBold"/>
            </Button>
            <Button Grid.Column="5" Content="×" ToolTip="Kapat" FontSize="25" Foreground="White" Background="Transparent" BorderThickness="0" Width="44" Height="48" Cursor="Hand" Click="Close_Click"/>
          </Grid>
        </Grid>
        <!-- SOL MENÜ -->
        <Grid Grid.Row="1" Grid.Column="0" Background="#0B162B">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <ScrollViewer x:Name="NavigationScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <DockPanel MinHeight="{Binding ViewportHeight, ElementName=NavigationScroll}" LastChildFill="False">
              <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="İŞLEM MENÜSÜ" Foreground="#8FA8C0" FontSize="10.5" Margin="20,7,0,8"/>
                <!-- 1. GRUP: ANA EKRAN -->
                <Button x:Name="NavHome" Style="{StaticResource NavButton}" Tag="Active" Click="NavHome_Click">
                  <StackPanel Orientation="Horizontal">
                    <local:NavigationIcon Kind="Home" Width="18" Height="18" Margin="0,0,10,0"/>
                    <TextBlock Text="ANA EKRAN" VerticalAlignment="Center" FontSize="11"/>
                  </StackPanel>
                </Button>
                <Border Height="3" Background="#557A9D" Margin="16,6,16,6" CornerRadius="1.5"/>
                <!-- 2. GRUP: VERİ GİRİŞİ -->
                <StackPanel x:Name="DataEntrySubmenu" Margin="0,1,0,4">
                  <Button x:Name="NavInstitution" Style="{StaticResource SubNavButton}" Click="NavInstitution_Click">
                    <StackPanel Orientation="Horizontal">
                      <local:NavigationIcon Kind="Institution" Width="18" Height="18" Margin="0,0,10,0"/>
                      <TextBlock Text="KURUM BİLGİSİ" VerticalAlignment="Center" FontSize="11"/>
                    </StackPanel>
                  </Button>
                  <Button x:Name="NavGeneral" Style="{StaticResource SubNavButton}" Click="NavGeneral_Click">
                    <StackPanel Orientation="Horizontal">
                      <local:NavigationIcon Kind="Products" Width="18" Height="18" Margin="0,0,10,0"/>
                      <TextBlock Text="MAL/HİZMET BİLGİSİ" VerticalAlignment="Center" FontSize="11"/>
                    </StackPanel>
                  </Button>
                  <Button x:Name="NavFirmsOffers" Style="{StaticResource SubNavButton}" Click="NavFirmsOffers_Click">
                    <StackPanel Orientation="Horizontal">
                      <local:NavigationIcon Kind="Firms" Width="18" Height="18" Margin="0,0,10,0"/>
                      <TextBlock Text="FİRMALAR/TEKLİFLER" VerticalAlignment="Center" FontSize="11"/>
                    </StackPanel>
                  </Button>
                  <Button x:Name="NavApprovalDocument" Style="{StaticResource SubNavButton}" Click="NavApprovalDocument_Click">
                    <StackPanel Orientation="Horizontal">
                      <local:NavigationIcon Kind="Approval" Width="18" Height="18" Margin="0,0,10,0"/>
                      <TextBlock Text="ONAY BELGESİ" VerticalAlignment="Center" FontSize="11"/>
                    </StackPanel>
                  </Button>
                  <Button x:Name="NavDocumentsDates" Style="{StaticResource SubNavButton}" Click="NavDocumentsDates_Click" ToolTip="Diğer işlem tarihleri ve Onay Belgesi tarih bilgisi">
                    <StackPanel Orientation="Horizontal">
                      <local:NavigationIcon Kind="Calendar" Width="18" Height="18" Margin="0,0,10,0"/>
                      <TextBlock Text="TARİHLER" VerticalAlignment="Center" FontSize="11"/>
                    </StackPanel>
                  </Button>
                  <Button x:Name="NavOutput" Style="{StaticResource SubNavButton}" Click="NavOutput_Click" ToolTip="Ön hazırlık ve nihai işlem PDF belgeleri">
                    <StackPanel Orientation="Horizontal">
                      <local:NavigationIcon Kind="Output" Width="18" Height="18" Margin="0,0,10,0"/>
                      <TextBlock Text="ÇIKTILAR" VerticalAlignment="Center" FontSize="11"/>
                    </StackPanel>
                  </Button>
                  <Button x:Name="NavArchive" Style="{StaticResource NavButton}" Click="NavArchive_Click">
                    <StackPanel Orientation="Horizontal">
                      <local:NavigationIcon Kind="Archive" Width="18" Height="18" Margin="0,0,10,0"/>
                      <TextBlock Text="İŞLEM ARŞİVİ" VerticalAlignment="Center" FontSize="11"/>
                    </StackPanel>
                  </Button>
                </StackPanel>
                <Border Height="3" Background="#557A9D" Margin="16,6,16,6" CornerRadius="1.5"/>
              </StackPanel>
              <StackPanel DockPanel.Dock="Bottom" x:Name="BottomNavigation">
                <!-- İstatistik ve uygulama ayarları -->
                <Button x:Name="NavStatistics" Style="{StaticResource NavButton}" Click="NavStatistics_Click">
                  <StackPanel Orientation="Horizontal">
                    <local:NavigationIcon Kind="Chart" Width="18" Height="18" Margin="0,0,10,0"/>
                    <TextBlock Text="İSTATİSTİKLER" VerticalAlignment="Center" FontSize="11"/>
                  </StackPanel>
                </Button>
                <Button x:Name="NavSettings" Style="{StaticResource NavButton}" Click="NavSettings_Click">
                  <StackPanel Orientation="Horizontal">
                    <local:NavigationIcon Kind="Settings" Width="18" Height="18" Margin="0,0,10,0"/>
                    <TextBlock Text="AYARLAR" VerticalAlignment="Center" FontSize="11"/>
                  </StackPanel>
                </Button>
                <Button x:Name="NavAboutSafety" Style="{StaticResource NavButton}" Click="NavAboutSafety_Click">
                  <StackPanel Orientation="Horizontal">
                    <local:NavigationIcon Kind="Shield" Width="18" Height="18" Margin="0,0,10,0"/>
                    <TextBlock Text="HAKKINDA/GÜVENLİK" VerticalAlignment="Center" FontSize="11"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </DockPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="1">
            <Border Height="1" Background="#384C64" Margin="18,8,18,14"/>
            <shell:InstitutionSignatureCard x:Name="InstitutionSignatureCard" Margin="12,0,12,14"/>
          </StackPanel>
        </Grid>
        <!-- İÇERİK -->
        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource Navy950Brush}" CornerRadius="13,0,13,0" Padding="16">
          <ScrollViewer x:Name="WorkspaceScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="WorkspaceLayout" MinWidth="700">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <!-- ANA EKRAN -->
              <workspace:HomePage Grid.Row="1" x:Name="HomePageHost"/>
              <!-- GENEL -->
              <catalog:ProductsPage Grid.Row="1" x:Name="ProductsPageHost"/>
              <!-- ONAY BELGESİ -->
              <documents:ApprovalPage Grid.Row="1" x:Name="ApprovalPageHost"/>
              <!-- BELGE TARİHLERİ -->
              <!-- R16: varsayılan pencereye sığan, ekstra dikey scroll gerektirmeyen kompakt çıktı yerleşimi -->
              <documents:DocumentsPage Grid.Row="1" x:Name="DocumentsPageHost"/>
              <!-- KURUM BİLGİSİ / KOMİSYON -->
              <institution:InstitutionPage Grid.Row="1" x:Name="InstitutionPageHost"/>
              <!-- ÇIKTI -->
              <!-- İSTATİSTİKLER / YÖNETİM PANELİ -->
              <statistics:StatisticsPage Grid.Row="1" x:Name="StatisticsPageHost"/>
              <!-- İŞLEM ARŞİVİ -->
              <archive:ArchivePage Grid.Row="1" x:Name="ArchivePageHost"/>
              <institution:SettingsPage Grid.Row="1" x:Name="SettingsPageHost"/>
              <!-- HAKKINDA / VERİ GÜVENLİĞİ -->
              <safety:SafetyPage Grid.Row="1" x:Name="SafetyPageHost"/>
              <!-- FİRMALAR -->
              <offers:FirmsOffersPage Grid.Row="1" x:Name="FirmsOffersPageHost"/>
              <Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="ArchiveEditBar" Visibility="Collapsed" Grid.Row="0" Style="{StaticResource WorkspaceNote}" Padding="12" Margin="0,0,0,12">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="245"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="ArchiveEditStatusText" Foreground="{StaticResource PremiumMutedTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                  <Button x:Name="ArchiveChangesSaveButton" Grid.Column="1" Content="DEĞİŞİKLİKLERİ KAYDET" Style="{StaticResource WorkspaceAction}" IsEnabled="False" Height="40" Click="Save_Click"/>
                </Grid>
              </Border>
            </Grid>
          </ScrollViewer>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
